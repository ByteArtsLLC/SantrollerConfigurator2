{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Santroller Configurator",
  "version": "../package.json",
  "identifier": "com.santroller.configurator",
  "build": {
    "beforeDevCommand": "yarn dev-nobuild --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Santroller Configurator",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Configure Santroller powered controllers",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-santroller.rules": "../public/70-santroller.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-santroller.rules": "../public/70-santroller.rules"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MDczNTU4OTIzMzBCRkYKUldUL0N6T1NXRFVIbVNuZXdydVNpKzQ0dFhsVjJQTE1RV0RCdVJpL1Q4SlZoTFcxNTE2NGpKU1gK",
      "endpoints": [
        "https://github.com/Santroller/SantrollerConfigurator2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
